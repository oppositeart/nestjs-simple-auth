# Copy this file to `.env` and replace the placeholders with your real values.

NODE_ENV='development'

# PostgreSQL (>= 15). The values below match docker-compose.yml.
POSTGRES_USER='root'
POSTGRES_PASSWORD='change-me'
POSTGRES_HOST='localhost'
POSTGRES_PORT='5433'
POSTGRES_DATABASE='nestjs-course'
POSTGRES_URI='postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}'

# For JWT secrets use two different random values.
JWT_SECRET='change-me'
JWT_REFRESH_SECRET='change-me-too'
JWT_ACCESS_TTL='30m'
JWT_REFRESH_TTL='7d'

COOKIE_DOMAIN='localhost'
